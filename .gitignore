# Java / Maven
backend/target/
*.class
*.jar
!**/maven-wrapper.jar

# Node / Next.js
frontend/node_modules/
tools/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
.venv-evaluation/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Local secrets
.env

# Credentials for one-off scripts (scripts/seed-remote.sh). Kept in a file
# rather than on the command line so they never reach shell history, `ps`
# output, or a screenshot of a terminal.
backend/.env.seed
*.env.seed
!*.env.seed.example

# Database dumps written by scripts/backup.sh. They contain the full corpus and
# have no business in version control.
backups/

# Local historical working copies. New canonical documentation stays trackable.
/docs/ARCHITECTURE.md
/docs/MONTH-1-PROJECT-REPORT.md
/docs/MONTH-1-STATUS.md
/docs/PHASE-5-VERIFICATION.md
/docs/civictrack-app-blueprint.md
/docs/civictrack-claude-code-prompts.md
/docs/civictrack-java-blueprint.md
/docs/civictrack-project-report.md

# Local verification screenshots and walk output (large, regenerable). Keep
# the small, reproducible phase-8 result tables and vector plots.
artifacts/*
!artifacts/evaluation/
!artifacts/evaluation/*.csv
!artifacts/evaluation/*.pdf

# Optional dataset refresh tools.
scripts/__pycache__/

# Nested development/build output and Python environments
**/node_modules/
**/target/
**/.next/
**/coverage/
**/__pycache__/
*.py[cod]
.venv/
.venv-*/
*.tsbuildinfo
.cache/

# Private environment variants; sanitized templates remain trackable
.env.*
*.env
*.env.*
!**/.env.example
!**/.env.seed.example

# Local logs, temporary/editor files and database exports
*.log
*.tmp
*.temp
*.swp
*~
*.dump
*.dump.gz
*.dump.gz.gpg
*.backup
*.sql.gz

# Browser auth/network state is private, including outside artifacts/
.auth/
playwright/.auth/
storage-state*.json
*.har
.vercel/

# LaTeX scratch output; keep the intentional manuscript QA inputs/results
/paper/build/*
!/paper/build/QA.md
!/paper/build/artifact-hashes.json
!/paper/build/compile-console.log
!/paper/build/fonts.txt
!/paper/build/main.bbl
!/paper/build/main.blg
!/paper/build/main.log
!/paper/build/pdfinfo.txt
!/paper/build/qa.json
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.synctex.gz
/paper/main.pdf
